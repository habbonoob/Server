{
  "Web": {
    "UrlPrefix": "https://hotel.example.com",
    "BehindProxy": true,
    "NoIndex": true
  },
  "Gateway": {
    "MaxConnectionsPerAddress": 0
  },
  "Seed": {
    "Directory": "/app/seed"
  },
  "Assets": {
    "MirrorDirectory": "/data/assets"
  },
  "Camera": {
    "PhotoDirectory": "/data/photos",
    "LocalLibraryDirectory": "/app/seed/camera"
  },
  "Auth": {
    "KeysDirectory": "/data/keys",
    "StartingCredits": 5000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Orleans": "Warning"
    }
  }
}
